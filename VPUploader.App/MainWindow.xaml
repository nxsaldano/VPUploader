<ui:FluentWindow x:Class="VPUploader.App.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="VPUploader" Height="540" Width="500" MinHeight="540" MinWidth="400"
                  Icon="Assets/wacotexas.ico"
                  Loaded="Window_Loaded"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Acrylic"
                  WindowStartupLocation="CenterScreen">
    
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>
    
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <Rectangle Grid.Row="0" Grid.RowSpan="2" Opacity="0.75">
            <Rectangle.Fill>
                <ImageBrush ImageSource="Assets/bewear.jpg" Stretch="UniformToFill" />
            </Rectangle.Fill>
        </Rectangle>

        <ui:TitleBar Grid.Row="0" Title="VPUploader" Icon="{ui:ImageIcon 'Assets/wacotexas.ico'}" />

        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="Choose Image..." Click="ChooseImage_Click" HorizontalAlignment="Left" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Text="{Binding SelectedFilePath}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

            <ComboBox Grid.Row="2" ItemsSource="{Binding Boards}" SelectedItem="{Binding SelectedBoard}" Margin="0,0,0,8" />

            <ui:TextBox Grid.Row="3" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                        PlaceholderText="Title (optional)" />
            <ui:TextBox Grid.Row="4" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                        PlaceholderText="Description (optional)"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        Height="120" />
            <ui:TextBox Grid.Row="5" Text="{Binding Link, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                        PlaceholderText="Link (optional)" />
            <ui:TextBox Grid.Row="6" Text="{Binding AltText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                        PlaceholderText="Alt text (optional)" />

            <StackPanel Grid.Row="7" VerticalAlignment="Bottom">
                <Button Content="Connect to Pinterest" Command="{Binding ConnectCommand}"
                        Visibility="{Binding IsNotSignedIn, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,8" />
                <Button Content="Upload" Command="{Binding UploadCommand}" HorizontalAlignment="Left" Padding="12,4" />
                <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0"
                           Visibility="{Binding HasPinLink, Converter={StaticResource BoolToVis}}">
                    <Hyperlink Command="{Binding OpenPinCommand}">View pin on Pinterest</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>